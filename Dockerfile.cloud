# course-rag 的云端部署镜像（适用于 Render / Hugging Face 等云平台，在云厂商海外服务器构建）
# 与本地 Dockerfile 的区别：
#   1. 基础镜像用官方源（云构建机可直连 Docker Hub / ghcr.io，无需国内代理）；
#   2. 启动 Gradio 网页，监听 0.0.0.0 并读取平台注入的 $PORT（Render 默认 10000，HF 为 7860）；
#   3. 不挂数据卷（云容器为临时运行，每次启动根据内置 data/ 自动重建索引）。
# API Key 不写进镜像，在平台的环境变量 / Secrets 里配置 SILICONFLOW_API_KEY。
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 1) 装依赖。uv.lock 里锁定的是国内阿里云源，海外构建时替换为官方 PyPI（包内容/哈希一致）
COPY pyproject.toml uv.lock ./
RUN sed -i 's|https://mirrors.aliyun.com/pypi/simple/|https://pypi.org/simple|g' uv.lock \
    && uv sync --frozen --no-dev --no-install-project

# 2) 拷源码并安装项目本身
COPY src ./src
COPY README.md ./
RUN uv sync --frozen --no-dev

# 3) 内置示例讲义（容器首次启动、索引库为空时自动建索引）
COPY data ./data

ENV PATH="/app/.venv/bin:$PATH"
# Render 默认注入 PORT=10000；Gradio(app.py) 会读取 PORT 环境变量绑定，无需写死端口
EXPOSE 10000

# 云平台会把配置的环境变量（如 SILICONFLOW_API_KEY）注入容器
CMD ["python", "-m", "course_rag.app"]
