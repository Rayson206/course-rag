# course-rag 服务镜像（国内网络适配版）
# 与 Dockerfile 唯一的区别：基础镜像地址加了 docker.m.daocloud.io 公开代理前缀，
# 解决国内直连 Docker Hub / ghcr.io 超时的问题。逻辑、依赖、启动命令完全一致。
# 用法：docker build -f Dockerfile.cn -t course-rag:latest .
FROM docker.m.daocloud.io/library/python:3.13-slim

# 从 uv 官方镜像拷贝 uv 二进制（走 DaoCloud 的 ghcr 专用代理）
COPY --from=ghcr.m.daocloud.io/astral-sh/uv:0.13.1 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 1) 先装依赖：依赖清单变动频率低，单独成层可利用 Docker 构建缓存
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# 2) 拷源码并安装项目本身
COPY src ./src
COPY README.md ./
RUN uv sync --frozen --no-dev

# 3) 内置示例讲义（容器首次启动、索引库为空时会自动建索引）
COPY data ./data

# API Key 不打进镜像，运行时传入：
#   docker run -e SILICONFLOW_API_KEY=sk-xxx ...
# 向量库与资料目录挂载数据卷持久化
VOLUME ["/app/chroma_db", "/app/data"]

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1

CMD ["uvicorn", "course_rag.api:app", "--host", "0.0.0.0", "--port", "8000"]
